# Catalog DB
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=changeme

# Booking DB
BOOKING_DB_NAME=booking
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=changeme

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Hold TTL (seconds, shorten in test profiles)
HOLD_TTL_SECONDS=420

# Payment DB
PAYMENT_DB_NAME=payment
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=changeme

# Payment config
PAYMENT_FAILURE_RATE=0.0
# Stripe webhook signing secret (whsec_... from `stripe listen`). Test mode only, never commit a real one.
STRIPE_WEBHOOK_SECRET=

# Identity DB
IDENTITY_DB_NAME=identity
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=changeme
# JWT signing key (STAM-454): RSA PKCS#8, base64 on one line. Optional
# locally; without it a key is generated per identity start. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# (the pkcs8 step matters: some OpenSSL builds write genpkey's DER as PKCS#1)
IDENTITY_RSA_PRIVATE_KEY=

# Notification DB
NOTIFICATION_DB_NAME=notification
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=changeme

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
